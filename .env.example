# Naver CLOVA OCR & Google Gemini API Environment Variables Example
# Cloudflare Pages Dashboard (Settings -> Environment variables) 에 등록하거나
# 로컬 개발 시 .dev.vars 파일에 선언하여 사용합니다.

# 1. 네이버 클라우드 플랫폼 CLOVA OCR API
CLOVA_OCR_INVOKE_URL=https://xxxxxxxx.apigw.ntruss.com/custom/v1/XXXXX/XXXXX/general
CLOVA_OCR_SECRET_KEY=YourClovaOcrSecretKeyHere

# 2. Google Gemini API (주보 사전 판별용 gemini-1.5-flash 모델)
GEMINI_API_KEY=YourGeminiApiKeyHere
